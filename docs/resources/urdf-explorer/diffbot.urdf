    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.02"/>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_caster_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.076 -0.0 0.0045"/>
    <parent link="chassis_link"/>
    <child link="rear_caster_base_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <gazebo reference="rear_caster_base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <link name="rear_caster_rotation_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="2.666666666666667e-06" ixy="0.0" ixz="0.0" iyy="2.666666666666667e-06" iyz="0.0" izz="2.666666666666667e-06"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.02"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.02"/>
      <geometry>
        <mesh filename="package://diffbot_description/meshes/diffbot/caster_wheel_support.stl"/>
      </geometry>
      <material name="silver"/>
